RewriteEngine On

# Redirect old WWW to non-WWW (optional, but good for SEO)
RewriteCond %{HTTP_HOST} ^www\.harmonyclinic\.od\.ua$ [NC]
RewriteRule ^(.*)$ https://harmonyclinic.od.ua/$1 [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# Doctor page — все варианты написания фамилии
# ведут на каноническую страницу доктора
# ============================================
# RU варианты
RewriteRule ^ru/malyukyn-andrey/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/malyukin-andrey/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/malukin-andrey/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/maliukyn-andrey/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/doctor/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/vrach/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/doctors/?$ /ru/maliukin-andrey.html [L,R=301]

# UA варианты
RewriteRule ^malyukin-andriy/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^malyukin/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^maliukin/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^likar/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^likari/maliukin-andriy/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^likari/malyukin-andriy/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^doctors/maliukin-andrii/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^doctor/maliukin/?$ /maliukin-andriy.html [L,R=301]

# Старые WordPress-URL для услуг (если индексируются)
RewriteRule ^khudozhestvennaya-restavratsiya-zubov/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^ru/khudozhestvennaya-restavratsiya-zubov/?$ /ru/maliukin-andrey.html [L,R=301]

# Redirect old pages to new services/index page
# Doctors / Specialists
RewriteRule ^spetsialisty/?$ /maliukin-andriy.html [L,R=301]
RewriteRule ^ru/spetsialisty/?$ /ru/maliukin-andrey.html [L,R=301]
RewriteRule ^speczyalysty/?$ /maliukin-andriy.html [L,R=301]

# About clinic
RewriteRule ^o-klinike/?$ /index.html#about [L,R=301]

# Works/Cases
RewriteRule ^nashi-raboty/?$ /index.html#works [L,R=301]
RewriteRule ^nashi-roboti/?$ /index.html#works [L,R=301]

# Reviews
RewriteRule ^otzyvy/?$ /index.html#reviews [L,R=301]
RewriteRule ^vidhuky/?$ /index.html#reviews [L,R=301]

# Prices
RewriteRule ^tseny/?$ /index.html#prices [L,R=301]
RewriteRule ^tsiny/?$ /index.html#prices [L,R=301]

# Contacts
RewriteRule ^kontakty/?$ /index.html#contacts [L,R=301]

# Services (General)
RewriteRule ^uslugi/?$ /services-ua.html [L,R=301]
RewriteRule ^poslugy/?$ /services-ua.html [L,R=301]

# Specific Services (If you had them previously, redirect to new HTML files)
RewriteRule ^implantatsiya/?$ /implants-ua.html [L,R=301]
RewriteRule ^lechenie/?$ /lechenie-ua.html [L,R=301]
RewriteRule ^protezirovanie/?$ /prosthetics-ua.html [L,R=301]
RewriteRule ^ortodontiya/?$ /orthodontics-ua.html [L,R=301]
RewriteRule ^gigiena/?$ /hygiene-ua.html [L,R=301]
RewriteRule ^vydalennya/?$ /extraction-ua.html [L,R=301]

# Redirect any 404s to the homepage (optional, but helps catch missed old links)
ErrorDocument 404 /404.html

# Block access to Python scripts and test files
<FilesMatch "\.(py|pyc|backup)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Block test files
<FilesMatch "^test_">
    Order deny,allow
    Deny from all
</FilesMatch>

# Block .DS_Store
<Files .DS_Store>
    Order deny,allow
    Deny from all
</Files>

# Security Headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://www.facebook.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://www.facebook.com https://api.telegram.org; frame-src https://www.google.com https://maps.google.com;"
</IfModule>

# ============================================
# Gzip / Deflate compression (text-based assets)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf font/opentype font/ttf
</IfModule>

# ============================================
# Browser caching (mod_expires also emits Cache-Control: max-age)
# CSS/JS use a 1-month cache because filenames are not fingerprinted —
# a longer immutable cache would leave returning visitors on stale assets.
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                       "access plus 1 month"

    # HTML & structured data — always revalidate so edits go live immediately
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType application/json       "access plus 0 seconds"
    ExpiresByType application/ld+json    "access plus 0 seconds"

    # XML (sitemap) — short cache
    ExpiresByType application/xml        "access plus 1 hour"
    ExpiresByType text/xml               "access plus 1 hour"

    # CSS / JS — 1 month (non-fingerprinted filenames)
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript        "access plus 1 month"

    # Images — 1 year
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/gif              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
</IfModule>
